rules_version = '2';

// Règles Firestore pour JavaVault.
//
// Un seul utilisateur autorisé. Remplacer AUTHORIZED_UID par l'UID du compte
// personnel (identique à VITE_AUTHORIZED_UID côté client). Masquer un bouton
// d'inscription ne constitue PAS un contrôle d'accès : la restriction est ici.
//
// Le document stocké ne contient que l'enveloppe chiffrée + une révision ;
// aucun secret en clair ne transite ni n'est lisible côté serveur.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorized() {
      return request.auth != null
        && request.auth.uid == '1K3SX1iClfaRRVAumpp0Rbe4ODE2';
    }

    // Coffre personnel : vaults/{uid}. Seul l'UID autorisé accède à SON document.
    match /vaults/{uid} {
      allow read, write: if isAuthorized() && uid == request.auth.uid;

      // Morceaux du ciphertext quand le coffre dépasse ~700 Ko (toujours chiffré).
      match /chunks/{chunkId} {
        allow read, write: if isAuthorized() && uid == request.auth.uid;
      }
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
